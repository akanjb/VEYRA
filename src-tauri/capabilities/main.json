{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The dashboard window. Grants only the application commands it needs, plus listening to (and unlistening from) the application's own events; no other core plugin.",
  "windows": ["main"],
  "permissions": [
    "allow-get-app-info",
    "allow-list-sources",
    "allow-set-source-enabled",
    "allow-request-rescan",
    "allow-get-telemetry-receiver",
    "allow-set-telemetry-receiver",
    "allow-get-capture-proxy",
    "allow-set-capture-proxy",
    "allow-get-overview",
    "allow-get-usage",
    "allow-get-cost",
    "allow-get-cost-assumptions",
    "allow-get-what-if",
    "allow-get-cache",
    "allow-get-models",
    "allow-get-activity",
    "allow-get-tools",
    "allow-list-projects",
    "allow-get-project",
    "allow-rename-project",
    "allow-merge-project",
    "allow-unmerge-project",
    "allow-get-billing",
    "allow-save-billing-entry",
    "allow-delete-billing-entry",
    "allow-save-budget",
    "allow-delete-budget",
    "allow-preview-export",
    "allow-save-export",
    "allow-get-storage",
    "allow-create-backup",
    "allow-preview-restore",
    "allow-restore-backup",
    "allow-preview-delete",
    "allow-delete-data",
    "allow-list-sessions",
    "allow-get-session",
    "core:event:allow-listen",
    "core:event:allow-unlisten"
  ]
}
