{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The dashboard window. Grants only the application commands it needs; no core plugins.",
  "windows": ["main"],
  "permissions": [
    "allow-get-app-info",
    "allow-list-sources",
    "allow-set-source-enabled",
    "allow-request-rescan",
    "allow-get-overview",
    "allow-list-sessions",
    "allow-get-session"
  ]
}
